NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gift_signal
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3000
BUSINESS_BASE_URL=http://localhost:3001
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LINK_AUTHORITY_SIGNING_KEY=
AUDIT_HASH_SECRET=
SESSION_SECRET=
LOG_LEVEL=info

# Comma-separated org_id:secret:capability|capability entries for agent/API access.
# Example capabilities: recommend_gifts, build_bundle, record_telemetry. Use a secret manager in production.
GIFT_SIGNAL_API_KEYS=
# Production format: org_id:credential_id:sha256(secret):capability|capability
GIFT_SIGNAL_API_KEY_HASHES=

# Optional Muse live-mode configuration. Meta Model API is OpenAI-compatible; use the exact base URL/model ID from your Meta developer account.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MUSE_MODEL=
META_MUSE_TIMEOUT_MS=8000
META_MUSE_RETRIES=2
DEMO_PORT=3100

# Production runtime gates
APP_MODE=demo
DRAFT_TTL_MS=900000
RATE_LIMIT_PER_MINUTE=120

# Zero-trust transaction authority. Store only in the deployment secret manager.
DRAFT_SIGNING_SECRET=
APPROVAL_SIGNING_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

API_RATE_LIMIT_PER_MINUTE=120

# Authenticated native model host: keep disabled until controlled validation.
MUSE_AGENT_ENABLED=false
MUSE_TRANSACTION_AGENT_ID=
SHOP_OIDC_USER_ID_CLAIM=
AUDIT_SIGNING_SECRET=
PROVIDER_TOKEN_ENCRYPTION_KEY=
PROVIDER_OAUTH_STATE_SECRET=
PROVIDER_OAUTH_CALLBACK_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_SCOPES=
MERCHANT_PROVIDER_CREDENTIALS_CONFIGURED=false

# Test-store attestation for preflight only; these flags do not create a test store.
SHOPIFY_TEST_STORE_CONFIRMED=false
SHOPIFY_TEST_SHOP_DOMAIN=


# Live activation points (see docs/live-readiness.md). All values go
# in the deployment secret manager only — never in the repo. Empty
# here means the gated path fails closed, which is the demo behaviour.
SHOP_PAY_EXECUTION_ENABLED=false
SHOP_PAY_API_KEY=
SHOP_PAY_CHECKOUT_CLIENT=
META_VERIFICATION_WEBHOOK_SECRET=
META_REEL_CALLBACK_SIGNING_SECRET=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
MUSE_GENERIC_ADAPTER_CONFIG_JSON=

# Read-only Meta catalog client (see docs/meta-catalog-client.md).
# Names only; values go in the deployment secret manager, never in the
# repo. Empty here means the gated path fails closed (demo behaviour).
# Defaults when empty: base https://graph.facebook.com, version v26.0.
META_CATALOG_ACCESS_TOKEN=
META_CATALOG_ID=
META_GRAPH_API_BASE_URL=
META_GRAPH_API_VERSION=
